{
  "name": "km-portal-cu-nurse-automation",
  "version": "1.0.0",
  "description": "Playwright automation for KM-Portal CU-Nurse (Auto:Y test cases from the QA test-case spreadsheets)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:auth": "playwright test tests/auth",
    "test:public": "playwright test tests/public",
    "test:fusr": "playwright test tests/admin",
    "test:admu": "playwright test tests/admin/user-list",
    "test:roles": "playwright test tests/admin/roles",
    "test:categories": "playwright test tests/admin/categories",
    "test:activity-log": "playwright test tests/admin/activity-log",
    "test:dashboard": "playwright test tests/admin/dashboard",
    "test:sitemap": "playwright test tests/admin/sitemap",
    "test:cops": "playwright test tests/admin/cops",
    "test:news": "playwright test tests/admin/news",
    "test:knowledge": "playwright test tests/admin/knowledge",
    "test:bestpractice": "playwright test tests/admin/bestpractice",
    "test:faq": "playwright test tests/admin/faq tests/public/faq.spec.ts",
    "test:contact": "playwright test tests/admin/contact tests/public/contact.spec.ts",
    "test:activity": "playwright test tests/admin/activity/activity.spec.ts",
    "test:home": "playwright test tests/admin/home",
    "test:search": "playwright test tests/public/search.spec.ts",
    "test:content-p": "playwright test tests/admin/knowledge/knowledge-files.spec.ts tests/admin/knowledge/knowledge-workflow.spec.ts tests/admin/news/news-workflow.spec.ts tests/admin/news/news-form-files.spec.ts tests/admin/bestpractice/bestpractice-workflow.spec.ts tests/admin/bestpractice/bestpractice-form-files.spec.ts",
    "test:nfr": "playwright test tests/nfr",
    "test:security": "playwright test tests/security",
    "test:list": "playwright test --list",
    "test:evidence": "node scripts/run-with-evidence.js",
    "test:new": "node scripts/test-round.js new",
    "test:continue": "node scripts/test-round.js continue",
    "test:round": "node scripts/test-round.js status",
    "evidence:archive": "node scripts/archive-evidence.js",
    "cleanup:data": "node scripts/cleanup-test-data.js",
    "cleanup:users": "node scripts/cleanup-test-data.js --only users",
    "cleanup:roles": "node scripts/cleanup-test-data.js --only roles",
    "cleanup:categories": "node scripts/cleanup-test-data.js --only categories",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "generate:pending": "node scripts/generate-pending-tests.js",
    "generate:traceability": "node scripts/generate-traceability.js",
    "generate:all": "npm run generate:pending && npm run generate:traceability",
    "test:srs": "playwright test tests/srs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "typescript": "^7.0.2",
    "xlsx": "^0.18.5"
  }
}
